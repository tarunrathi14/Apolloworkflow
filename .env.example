# Claude — parses your messages into structured items
ANTHROPIC_API_KEY=sk-ant-...

# Telegram — @BotFather gives you the token; /start the bot then read your
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789
# Any random string; Telegram echoes it back so you can reject forged webhooks
TELEGRAM_WEBHOOK_SECRET=change-me

ASSISTANT_CONFIG=config.yaml
ASSISTANT_DB=assistant.db
RUN_SCHEDULER=1
